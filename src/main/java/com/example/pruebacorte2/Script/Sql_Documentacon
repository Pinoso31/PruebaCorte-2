--- Creacion de base de datos Papeleria Campus ---
CREATE DATABASE papeleria_campus


-- Creacion SHECHEMA Catalogo --
CREATE SCHEMA catalogo

-- Creacion tabla categoria --
CREATE TABLE catalogo.categoria
(
	id_categoria INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	nombre VARCHAR(50) NOT NULL UNIQUE


);


-- Creacion tabla Producto --
CREATE TABLE catalogo.producto
(
    id_producto INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    codigo VARCHAR(10) NOT NULL UNIQUE
        CONSTRAINT chk_codigo_no_vacio CHECK (length(trim(codigo)) > 0),

    nombre VARCHAR(80) NOT NULL
        CONSTRAINT chk_nombre_longitud CHECK (length(trim(nombre)) >= 3),

    categoria VARCHAR(20) NOT NULL
        CONSTRAINT chk_categoria_permitida CHECK (categoria IN ('Papelería', 'Tecnología', 'Accesorios')),

    precio NUMERIC(10,2) NOT NULL
        CONSTRAINT chk_precio_positivo CHECK (precio > 0.1),

    stock INTEGER NOT NULL
        CONSTRAINT chk_stock_no_negativo CHECK (stock >= 0)
);

-- Insercion de datos en tabla Categoria --

